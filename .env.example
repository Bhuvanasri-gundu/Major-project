# ============================================================
# Environment Variables — mHealth Hypothesis Generation
# Copy this file to .env and fill in your credentials
# ============================================================

# Google Gemini API Key (required for hypothesis generation and LLM judge)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Google API Key (fallback if GEMINI_API_KEY not set)
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: Override LLM model name (default: gemini-2.0-flash)
# LLM_MODEL_NAME=gemini-2.0-flash

# Optional: Set to "true" to use mock LLM responses (no API calls)
# USE_MOCK_LLM=false
